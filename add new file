   ROBOT STATE
   ============================================================ */
const robotEl = $('#robot');

function setRobotState(stateName) {
  robotEl.classList.remove('is-speaking', 'is-listening', 'is-happy', 'is-thinking');
  if (stateName) robotEl.classList.add('is-' + stateName);
}

function robotSpeak(text) {
  setRobotState('speaking');
  return new Promise(resolve => {
    TTS.speak(text, () => {
      setRobotState(null);
      resolve();
    });
  });
}

