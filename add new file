<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#060915">
<title>Sanad · سند — Learn Egyptian Arabic with Zaki</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
/* ============================================================
   0. TOKENS
   ============================================================ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --f-display:'Fraunces',Georgia,serif;
  --f-ui:'Inter',system-ui,-apple-system,sans-serif;
  --f-ar:'Cairo',system-ui,sans-serif;
  --f-mono:'JetBrains Mono',monospace;

  --bg:#060915;
  --bg-2:#0a0e1f;
  --surface:rgba(255,255,255,.045);
  --surface-2:rgba(255,255,255,.075);
  --border:rgba(255,255,255,.08);
  --border-2:rgba(255,255,255,.16);

  --gold:#f0c674;
  --gold-2:#d4a04a;
  --teal:#5eead4;
  --coral:#fb7185;
  --lilac:#c4b5fd;
  --sky:#7dd3fc;

  --text:#f0e9dc;
  --muted:#a89bb1;
  --dim:#6b5f7a;

  --ease:cubic-bezier(.22,1,.36,1);
  --spring:cubic-bezier(.34,1.56,.64,1);
}

html,body{min-height:100%;scroll-behavior:smooth}

body{
  font-family:var(--f-ui);
  background:var(--bg);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  text-rendering:optimizeLegibility;
  overflow-x:hidden;
  -webkit-tap-highlight-color:transparent;
  padding-bottom:0;
}

button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
::selection{background:rgba(240,198,116,.35)}

/* scrollbars */
*{scrollbar-width:thin;scrollbar-color:var(--border-2) transparent}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:var(--border-2);border-radius:8px;border:2px solid transparent;background-clip:content-box}
::-webkit-scrollbar-track{background:transparent}

:focus-visible{outline:2px solid var(--teal);outline-offset:3px;border-radius:6px}

/* ============================================================
   1. BACKGROUND LAYERS
   ============================================================ */
#stars-canvas{
  position:fixed;inset:0;z-index:-2;pointer-events:none;
  width:100%;height:100%;
}

.aurora{
  position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:
    radial-gradient(900px 700px at 15% -10%,rgba(240,198,116,.10),transparent 65%),
    radial-gradient(800px 600px at 90% 15%,rgba(94,234,212,.08),transparent 65%),
    radial-gradient(700px 700px at 55% 105%,rgba(196,181,253,.07),transparent 65%);
  animation:auroraShift 24s ease-in-out infinite alternate;
}
@keyframes auroraShift{
  0%{transform:scale(1) translate(0,0);opacity:1}
  50%{transform:scale(1.08) translate(-2%,1%);opacity:.85}
  100%{transform:scale(1) translate(1%,-1%);opacity:1}
}

/* ============================================================
   2. NAV
   ============================================================ */
.nav{
  position:sticky;top:0;z-index:50;
  display:flex;align-items:center;gap:clamp(12px,3vw,32px);
  padding:14px clamp(16px,4vw,40px);
  background:rgba(6,9,21,.7);
  backdrop-filter:blur(20px) saturate(1.4);
  -webkit-backdrop-filter:blur(20px) saturate(1.4);
  border-bottom:1px solid var(--border);
  animation:fadeDown .8s var(--ease) both;
}

.brand{
  display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit;
  flex:none;
}
.brand-mark{
  width:38px;height:38px;border-radius:11px;
  display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(240,198,116,.2),rgba(94,234,212,.1));
  border:1px solid var(--border-2);
  color:var(--gold);
  box-shadow:0 8px 24px -10px rgba(240,198,116,.5);
}
.brand-mark svg{width:20px;height:20px}
.brand-name{
  font-family:var(--f-display);
  font-size:18px;font-weight:600;letter-spacing:-.02em;
  display:flex;align-items:baseline;gap:6px;
}
.brand-name span{
  font-family:var(--f-ar);font-size:14px;color:var(--muted);
  font-weight:700;
}

.nav-links{
  display:flex;gap:4px;margin-left:auto;
}
.nav-links a{
  font-size:13px;font-weight:500;color:var(--muted);
  text-decoration:none;padding:9px 15px;border-radius:9px;
  transition:.25s var(--ease);
}
.nav-links a:hover{color:var(--text);background:var(--surface)}

.nav-cta{
  font-size:13px;font-weight:600;color:#1a0f00;
  background:linear-gradient(135deg,var(--gold),var(--gold-2));
  padding:10px 20px;border-radius:99px;
  transition:.3s var(--ease);
  box-shadow:0 8px 22px -8px rgba(240,198,116,.55);
}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 12px 28px -8px rgba(240,198,116,.7)}
.nav-cta:active{transform:scale(.97)}

@media(max-width:700px){
  .nav-links{display:none}
  .nav-cta{padding:9px 16px;font-size:12.5px}
}

/* ============================================================
   3. MEET SECTION (HERO + CHAT)
   ============================================================ */
.meet{
  position:relative;
  display:grid;
  grid-template-columns:minmax(280px,0.85fr) 1.15fr;
  gap:clamp(30px,5vw,70px);
  align-items:center;
  max-width:1360px;
  margin:0 auto;
  padding:clamp(30px,5vw,70px) clamp(18px,4vw,40px) clamp(50px,6vw,90px);
  min-height:calc(100vh - 68px);
}

/* ---------- Robot stage ---------- */
.robot-stage{
  position:relative;
  display:grid;place-items:center;
  min-height:min(520px,72vh);
  padding:20px;
}

.robot-halo{
  position:absolute;
  width:min(440px,88%);
  aspect-ratio:1;
  border-radius:50%;
  background:radial-gradient(circle,rgba(240,198,116,.28),rgba(94,234,212,.12) 45%,transparent 70%);
  filter:blur(28px);
  animation:haloPulse 5s ease-in-out infinite;
  z-index:0;
}
@keyframes haloPulse{
  0%,100%{transform:scale(1);opacity:.9}
  50%{transform:scale(1.08);opacity:1}
}

.robot{
  position:relative;z-index:2;
  width:min(340px,84%);
  filter:drop-shadow(0 24px 44px rgba(0,0,0,.55));
  animation:floatY 6s ease-in-out infinite;
}
@keyframes floatY{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-14px)}
}

/* Eyes */
.robot .eye-pupil{
  transform-box:fill-box;
  transform-origin:center;
  animation:blink 5.5s infinite;
}
@keyframes blink{
  0%,90%,100%{transform:scaleY(1)}
  94%{transform:scaleY(.1)}
}

/* Antenna bulb */
.robot .bulb{
  animation:bulbGlow 2.5s ease-in-out infinite;
  transform-box:fill-box;
  transform-origin:center;
}
@keyframes bulbGlow{
  0%,100%{opacity:1;filter:drop-shadow(0 0 6px var(--gold))}
  50%{opacity:.7;filter:drop-shadow(0 0 14px var(--gold))}
}

/* Mouth bars */
.robot .mouth-bar{
  transform-box:fill-box;
  transform-origin:center bottom;
  transition:transform .2s;
}
.robot.is-speaking .mouth-bar{
  animation:mouthSpeak .35s ease-in-out infinite alternate;
}
.robot.is-speaking .mouth-bar:nth-child(1){animation-delay:0s}
.robot.is-speaking .mouth-bar:nth-child(2){animation-delay:.06s}
.robot.is-speaking .mouth-bar:nth-child(3){animation-delay:.12s}
.robot.is-speaking .mouth-bar:nth-child(4){animation-delay:.18s}
.robot.is-speaking .mouth-bar:nth-child(5){animation-delay:.24s}
@keyframes mouthSpeak{
  from{transform:scaleY(1)}
  to{transform:scaleY(2.8)}
}

/* Chest scarab pulse */
.robot .scarab{
  transform-box:fill-box;
  transform-origin:center;
  transition:transform .3s;
}
.robot.is-speaking .scarab{
  animation:scarabPulse .6s ease-in-out infinite alternate;
}
@keyframes scarabPulse{
  from{transform:scale(1);filter:drop-shadow(0 0 4px var(--gold))}
  to{transform:scale(1.15);filter:drop-shadow(0 0 12px var(--gold))}
}

/* Listening rings */
.robot .listen-ring{
  opacity:0;
  transform-box:fill-box;
  transform-origin:center;
}
.robot.is-listening .listen-ring{
  animation:listenPulse 2s ease-out infinite;
}
.robot.is-listening .listen-ring.r2{animation-delay:.7s}
@keyframes listenPulse{
  0%{opacity:.55;transform:scale(.6)}
  100%{opacity:0;transform:scale(1.7)}
}

/* Emotion: happy squint */
.robot.is-happy .eye-pupil{animation:none;transform:scaleY(.4) translateY(2px)}

/* Emotion: thinking (look up) */
.robot.is-thinking .eye-pupil{
  animation:none;
  transform:translateY(-3px) scale(.9);
}

/* ---------- Speech bubble ---------- */
.speech-bubble{
  position:absolute;
  top:6%;
  right:2%;
  z-index:3;
  max-width:240px;
  padding:16px 18px;
  border-radius:18px 18px 18px 4px;
  background:linear-gradient(145deg,rgba(30,24,45,.92),rgba(20,16,32,.9));
  border:1px solid rgba(240,198,116,.25);
  backdrop-filter:blur(20px);
  box-shadow:0 20px 50px -20px rgba(0,0,0,.8);
  opacity:0;
  transform:translateY(10px) scale(.94);
  transition:.45s var(--spring);
}
.speech-bubble.show{opacity:1;transform:none}
.speech-bubble::after{
  content:'';position:absolute;bottom:-8px;left:24px;
  width:14px;height:14px;transform:rotate(45deg);
  background:rgba(30,24,45,.92);
  border-right:1px solid rgba(240,198,116,.25);
  border-bottom:1px solid rgba(240,198,116,.25);
}
.sb-ar{
  font-family:var(--f-ar);font-size:20px;font-weight:700;
  direction:rtl;text-align:right;line-height:1.4;margin-bottom:6px;
  color:#fff;
}
.sb-tr{font-size:11px;font-style:italic;color:var(--muted);margin-bottom:3px}
.sb-en{font-size:12px;color:var(--muted);opacity:.8}

@media(max-width:900px){
  .speech-bubble{top:0;right:-8px;max-width:180px;font-size:11px}
  .sb-ar{font-size:16px}
}

/* ---------- Right column ---------- */
.meet-right{min-width:0}

.eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-size:11px;font-weight:700;letter-spacing:.2em;
  text-transform:uppercase;color:var(--muted);
  margin-bottom:18px;
}
.eyebrow::before{
  content:'';width:26px;height:1px;background:var(--gold);opacity:.85;
}

.meet h1{
  font-family:var(--f-display);
  font-size:clamp(38px,5.4vw,66px);
  font-weight:600;letter-spacing:-.035em;line-height:1.02;
  margin-bottom:18px;
}
.meet h1 em{font-style:italic;color:var(--gold);font-weight:700}

.lede{
  font-size:clamp(14.5px,1.15vw,16.5px);
  line-height:1.7;color:var(--muted);max-width:52ch;
  margin-bottom:clamp(20px,3vw,32px);
}
.lede b{color:var(--text);font-weight:600}

/* ---------- Transcript ---------- */
.transcript{
  max-height:min(340px,40vh);
  overflow-y:auto;
  padding:16px;
  border-radius:20px;
  background:rgba(255,255,255,.025);
  border:1px solid var(--border);
  margin-bottom:14px;
  display:flex;flex-direction:column;gap:14px;
  scroll-behavior:smooth;
}
.transcript:empty::before{
  content:'Say hello to Zaki — tap the mic, type below, or pick a quick reply.';
  display:block;
  padding:20px 10px;
  text-align:center;
  font-size:12.5px;
  color:var(--dim);
  font-style:italic;
}

.msg{display:flex;gap:10px;max-width:92%;animation:msgIn .4s var(--ease) both}
@keyframes msgIn{
  from{opacity:0;transform:translateY(8px)}
  to{opacity:1;transform:none}
}
.msg--user{margin-left:auto;flex-direction:row-reverse}

.msg-av{
  width:32px;height:32px;border-radius:50%;flex:none;
  display:grid;place-items:center;font-size:16px;
  background:linear-gradient(145deg,rgba(240,198,116,.3),rgba(240,198,116,.1));
  border:1px solid rgba(240,198,116,.3);
}
.msg--user .msg-av{
  background:linear-gradient(145deg,rgba(94,234,212,.25),rgba(94,234,212,.08));
  border-color:rgba(94,234,212,.3);
}

.msg-content{
  padding:11px 15px;
  border-radius:14px;
  background:rgba(255,255,255,.05);
  border:1px solid var(--border);
  min-width:0;
  position:relative;
}
.msg--user .msg-content{
  background:linear-gradient(145deg,rgba(94,234,212,.18),rgba(94,234,212,.07));
  border-color:rgba(94,234,212,.28);
}
.msg--user .msg-text{font-size:13.5px;line-height:1.5;color:var(--text)}

.msg-ar{
  font-family:var(--f-ar);font-size:18px;font-weight:700;
  direction:rtl;text-align:right;line-height:1.5;margin-bottom:6px;
  color:#fff;
}
.msg-tr{font-size:11.5px;font-style:italic;color:var(--muted);margin-bottom:3px}
.msg-en{font-size:12px;color:var(--text);opacity:.75;line-height:1.5}

.msg-replay{
  display:inline-flex;align-items:center;gap:5px;margin-top:9px;
  font-size:10.5px;font-weight:600;color:var(--gold);
  background:rgba(240,198,116,.1);
  border:1px solid rgba(240,198,116,.28);
  padding:4px 10px;border-radius:99px;
  transition:.22s var(--ease);
}
.msg-replay:hover{background:rgba(240,198,116,.2)}
.msg-replay svg{width:10px;height:10px}

/* typing dots */
.typing{display:flex;gap:4px;padding:4px 2px}
.typing i{
  width:6px;height:6px;border-radius:50%;background:var(--muted);
  animation:typingBounce 1.3s infinite;
}
.typing i:nth-child(2){animation-delay:.18s}
.typing i:nth-child(3){animation-delay:.36s}
@keyframes typingBounce{
  0%,60%,100%{transform:translateY(0);opacity:.4}
  30%{transform:translateY(-5px);opacity:1}
}

/* ---------- Quick replies ---------- */
.quick-replies{
  display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px;
}
.quick-replies button{
  font-size:12px;font-weight:500;color:var(--muted);
  background:rgba(255,255,255,.045);
  border:1px solid var(--border);
  padding:8px 14px;border-radius:99px;
  transition:.25s var(--ease);
  animation:fadeUp .4s var(--ease) both;
}
.quick-replies button:nth-child(1){animation-delay:.1s}
.quick-replies button:nth-child(2){animation-delay:.15s}
.quick-replies button:nth-child(3){animation-delay:.2s}
.quick-replies button:hover{
  color:var(--gold);
  border-color:rgba(240,198,116,.4);
  background:rgba(240,198,116,.08);
  transform:translateY(-1px);
}

/* ---------- Input row ---------- */
.chat-input{
  display:flex;align-items:center;gap:9px;
  padding:8px;
  border-radius:16px;
  background:rgba(255,255,255,.04);
  border:1px solid var(--border);
  transition:.3s var(--ease);
  margin-bottom:12px;
}
.chat-input:focus-within{
  border-color:rgba(240,198,116,.4);
  background:rgba(255,255,255,.06);
}

.mic-btn{
  width:46px;height:46px;flex:none;border-radius:13px;
  display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(240,198,116,.2),rgba(240,198,116,.08));
  border:1px solid rgba(240,198,116,.35);
  color:var(--gold);
  transition:.3s var(--ease);
  position:relative;
}
.mic-btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px -8px rgba(240,198,116,.6)}
.mic-btn:active{transform:scale(.94)}
.mic-btn svg{width:20px;height:20px}
.mic-btn.is-active{
  background:linear-gradient(145deg,var(--coral),#e05a72);
  border-color:var(--coral);
  color:#fff;
  animation:micPulse 1.4s infinite;
}
@keyframes micPulse{
  0%,100%{box-shadow:0 0 0 0 rgba(251,113,133,.6)}
  50%{box-shadow:0 0 0 12px rgba(251,113,133,0)}
}

.chat-input input{
  flex:1;min-width:0;font-family:inherit;font-size:14px;
  color:var(--text);background:transparent;border:none;outline:none;
  padding:8px 6px;
}
.chat-input input::placeholder{color:var(--dim)}

.send-btn{
  width:46px;height:46px;flex:none;border-radius:13px;
  display:grid;place-items:center;
  background:linear-gradient(145deg,var(--teal),#3ec2b4);
  color:#062020;
  transition:.3s var(--ease);
  box-shadow:0 8px 20px -8px rgba(94,234,212,.6);
}
.send-btn:hover{transform:translateY(-1px) scale(1.03)}
.send-btn:active{transform:scale(.94)}
.send-btn svg{width:19px;height:19px}

/* ---------- Language toggle ---------- */
.lang-row{
  display:flex;align-items:center;gap:6px;
  font-size:11.5px;color:var(--dim);
  letter-spacing:.03em;
}
.lang-row button{
  font-size:11px;font-weight:600;
  padding:5px 11px;border-radius:99px;
  border:1px solid var(--border);
  background:transparent;color:var(--muted);
  transition:.22s var(--ease);
}
.lang-row button.on{
  color:var(--gold);
  border-color:rgba(240,198,116,.4);
  background:rgba(240,198,116,.1);
}

@media(max-width:900px){
  .meet{
    grid-template-columns:1fr;
    padding-top:20px;
    gap:20px;
    min-height:0;
  }
  .robot-stage{min-height:380px;padding:0}
  .robot{width:min(260px,70%)}
  .transcript{max-height:280px}
}
@media(max-width:520px){
  .robot-stage{min-height:300px}
  .robot{width:min(200px,64%)}
  .speech-bubble{position:relative;top:auto;right:auto;margin-top:14px;max-width:220px}
}

/* ============================================================
   4. SECTION TITLES
   ============================================================ */
.section{
  max-width:1200px;
  margin:0 auto;
  padding:clamp(50px,7vw,100px) clamp(18px,4vw,40px);
}

.sec-head{
  max-width:640px;
  margin-bottom:clamp(28px,4vw,44px);
}
.sec-head h2{
  font-family:var(--f-display);
  font-size:clamp(30px,4vw,48px);
  font-weight:600;letter-spacing:-.03em;line-height:1.05;
  margin-bottom:14px;
}
.sec-head h2 em{font-style:italic;color:var(--gold)}
.sec-head p{
  font-size:15px;line-height:1.7;color:var(--muted);max-width:52ch;
}

/* ============================================================
   5. LEARN — TOPIC CHIPS
   ============================================================ */
.topic-row{
  display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px;
}
.topic-btn{
  font-size:12.5px;font-weight:600;
  padding:10px 18px;border-radius:99px;
  background:rgba(255,255,255,.04);
  border:1px solid var(--border);
  color:var(--muted);
  transition:.25s var(--ease);
  display:inline-flex;align-items:center;gap:8px;
}
.topic-btn:hover{color:var(--text);border-color:var(--border-2);transform:translateY(-1px)}
.topic-btn.on{
  color:#1a0f00;
  background:linear-gradient(135deg,var(--gold),var(--gold-2));
  border-color:transparent;
  box-shadow:0 8px 22px -8px rgba(240,198,116,.5);
}
.topic-btn .count{
  font-size:10.5px;font-weight:700;
  background:rgba(0,0,0,.18);
  padding:2px 7px;border-radius:99px;
  font-variant-numeric:tabular-nums;
}
.topic-btn.on .count{background:rgba(0,0,0,.22);color:rgba(26,15,0,.85)}

/* ============================================================
   6. LEARN — PHRASE GRID
   ============================================================ */
.phrase-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
  gap:14px;
}

.phrase{
  position:relative;
  display:grid;
  grid-template-columns:auto 1fr auto;
  gap:14px;align-items:start;
  padding:18px;
  border-radius:18px;
  background:linear-gradient(155deg,rgba(255,255,255,.055),rgba(255,255,255,.015));
  border:1px solid var(--border);
  transition:.35s var(--ease);
  animation:cardIn .6s var(--ease) both;
  animation-delay:var(--d,0ms);
  overflow:hidden;
}
.phrase::before{
  content:'';position:absolute;inset:0;border-radius:18px;
  background:radial-gradient(circle at 20% 0%,rgba(240,198,116,.08),transparent 60%);
  opacity:0;transition:opacity .35s;
  pointer-events:none;
}
.phrase:hover{border-color:var(--border-2);transform:translateY(-3px);box-shadow:0 20px 40px -20px rgba(0,0,0,.7)}
.phrase:hover::before{opacity:1}
.phrase.done{
  border-color:rgba(94,234,212,.32);
  background:linear-gradient(155deg,rgba(94,234,212,.09),rgba(94,234,212,.02));
}
.phrase.done::before{
  background:radial-gradient(circle at 20% 0%,rgba(94,234,212,.15),transparent 60%);
  opacity:1;
}

@keyframes cardIn{
  from{opacity:0;transform:translateY(18px)}
  to{opacity:1;transform:none}
}

.check{
  width:28px;height:28px;flex:none;margin-top:3px;
  border-radius:50%;
  border:2px solid rgba(255,255,255,.2);
  background:transparent;
  display:grid;place-items:center;
  padding:0;
  transition:.28s var(--ease);
  cursor:pointer;
}
.check:hover{border-color:var(--gold);transform:scale(1.08)}
.check:active{transform:scale(.9)}
.check svg{
  width:14px;height:14px;
  fill:none;stroke:#060915;stroke-width:3;
  stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:26;stroke-dashoffset:26;
  transition:stroke-dashoffset .3s ease .04s;
}
.phrase.done .check{
  background:var(--teal);
  border-color:var(--teal);
  box-shadow:0 0 18px -4px var(--teal);
}
.phrase.done .check svg{stroke-dashoffset:0}

.p-body{min-width:0}

.p-ar{
  font-family:var(--f-ar);
  font-size:clamp(19px,2vw,22px);font-weight:700;
  direction:rtl;text-align:right;line-height:1.55;
  margin-bottom:5px;
  transition:color .3s;
}
.phrase.done .p-ar{color:rgba(255,255,255,.82)}

.p-tr{
  font-size:12px;font-style:italic;color:var(--muted);
  margin-bottom:5px;letter-spacing:.005em;
}

.p-en{
  font-size:13px;line-height:1.5;color:var(--text);opacity:.9;
}

.p-note{
  margin-top:10px;padding-top:10px;
  border-top:1px solid var(--border);
  font-size:11.5px;line-height:1.55;color:var(--dim);
  display:flex;gap:7px;
}
.p-note::before{
  content:'☛';color:var(--gold);flex:none;font-size:11px;
}

.play-btn{
  width:40px;height:40px;flex:none;border-radius:50%;
  display:grid;place-items:center;
  background:rgba(240,198,116,.13);
  border:1px solid rgba(240,198,116,.3);
  color:var(--gold);
  transition:.25s var(--ease);
}
.play-btn:hover{background:rgba(240,198,116,.25);transform:scale(1.08)}
.play-btn:active{transform:scale(.92)}
.play-btn svg{width:16px;height:16px;margin-left:2px}
.play-btn.playing{animation:playPulse 1s ease-out infinite}
@keyframes playPulse{
  0%{box-shadow:0 0 0 0 rgba(240,198,116,.55)}
  70%{box-shadow:0 0 0 12px rgba(240,198,116,0)}
  100%{box-shadow:0 0 0 0 rgba(240,198,116,0)}
}

@media(max-width:560px){
  .phrase{grid-template-columns:auto 1fr;gap:11px;padding:15px}
  .play-btn{grid-column:1/-1;justify-self:end;width:34px;height:34px;margin-top:-4px}
}

/* empty state */
.empty{
  grid-column:1/-1;
  padding:56px 24px;text-align:center;
  border:1px dashed var(--border-2);
  border-radius:20px;
  color:var(--muted);font-size:14px;
  animation:fadeUp .4s var(--ease) both;
}
.empty b{display:block;font-family:var(--f-display);font-size:20px;color:var(--text);margin-bottom:8px}

/* ============================================================
   7. PROGRESS SECTION
   ============================================================ */
.progress-layout{
  display:grid;
  grid-template-columns:auto 1fr;
  gap:clamp(30px,5vw,70px);
  align-items:center;
  padding:clamp(30px,4vw,50px);
  border-radius:26px;
  background:linear-gradient(155deg,rgba(255,255,255,.05),rgba(255,255,255,.015));
  border:1px solid var(--border);
  box-shadow:0 30px 70px -40px rgba(0,0,0,.8);
}
@media(max-width:700px){.progress-layout{grid-template-columns:1fr;text-align:center}}

.ring-wrap{
  position:relative;
  width:clamp(180px,22vw,240px);
  aspect-ratio:1;
  display:grid;place-items:center;
  flex:none;
  margin:0 auto;
}
.ring-wrap svg{
  position:absolute;inset:0;
  width:100%;height:100%;
  transform:rotate(-90deg);
}
.ring-track{
  fill:none;stroke:rgba(255,255,255,.06);stroke-width:8;
}
.ring-fill{
  fill:none;stroke:url(#ringGrad);stroke-width:8;
  stroke-linecap:round;
  stroke-dasharray:283;stroke-dashoffset:283;
  transition:stroke-dashoffset 1.4s var(--ease);
  filter:drop-shadow(0 0 8px rgba(240,198,116,.6));
}
.ring-inner{
  text-align:center;z-index:1;
}
.ring-pct{
  font-family:var(--f-display);
  font-size:clamp(36px,5vw,52px);font-weight:600;
  letter-spacing:-.03em;line-height:1;
  background:linear-gradient(135deg,var(--gold),var(--teal));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.ring-label{
  font-size:11px;letter-spacing:.15em;text-transform:uppercase;
  color:var(--muted);font-weight:600;margin-top:8px;
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:12px;
}
.stat-card{
  padding:20px;border-radius:16px;
  background:rgba(255,255,255,.035);
  border:1px solid var(--border);
  transition:.3s var(--ease);
}
.stat-card:hover{
  border-color:var(--border-2);
  transform:translateY(-2px);
  background:rgba(255,255,255,.055);
}
.stat-k{
  font-size:10.5px;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;color:var(--dim);
  margin-bottom:8px;
}
.stat-v{
  font-family:var(--f-display);
  font-size:clamp(24px,3vw,32px);font-weight:600;
  letter-spacing:-.02em;line-height:1;
  color:var(--text);
}
.stat-v small{
  font-family:var(--f-ui);font-size:12px;
  font-weight:500;color:var(--muted);margin-left:4px;
}

/* ============================================================
   8. FOOTER + WAVES
   ============================================================ */
.footer{
  position:relative;
  margin-top:0;
  padding-top:60px;
  overflow:hidden;
}
.waves{
  display:block;width:100%;height:90px;
}
.waves path{transition:fill .4s}
.wave-1{animation:waveShift 14s linear infinite}
.wave-2{animation:waveShift 18s linear infinite reverse}
.wave-3{animation:waveShift 22s linear infinite}
@keyframes waveShift{
  from{transform:translateX(0)}
  to{transform:translateX(-50%)}
}
.footer-inner{
  padding:24px clamp(18px,4vw,40px) 32px;
  text-align:center;
  font-size:12px;color:var(--dim);
  border-top:1px solid var(--border);
  background:rgba(6,9,21,.6);
}
.footer-inner b{color:var(--gold);font-weight:600}

/* ============================================================
   9. TOAST
   ============================================================ */
.toast{
  position:fixed;bottom:24px;left:50%;
  transform:translate(-50%,60px);
  z-index:100;
  display:flex;align-items:center;gap:10px;
  padding:12px 22px;border-radius:99px;
  background:rgba(30,24,45,.95);
  border:1px solid rgba(240,198,116,.3);
  color:var(--text);
  font-size:13px;font-weight:500;
  box-shadow:0 24px 50px -20px rgba(0,0,0,.9);
  opacity:0;pointer-events:none;
  transition:.45s var(--spring);
  max-width:min(90vw,420px);
}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast::before{
  content:'';width:8px;height:8px;border-radius:50%;
  background:var(--teal);flex:none;
  box-shadow:0 0 0 4px rgba(94,234,212,.2);
}

/* ============================================================
