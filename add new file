const transcriptEl = $('#transcript');

function addMessage(role, content) {
  const wrap = document.createElement('div');
  wrap.className = 'msg msg--' + role;

  const avatar = document.createElement('div');
  avatar.className = 'msg-av';
  avatar.textContent = role === 'bot' ? '🤖' : '🧑‍⚕️';

  const box = document.createElement('div');
  box.className = 'msg-content';

  if (role === 'bot') {
    const ar = document.createElement('div');
    ar.className = 'msg-ar';
    ar.dir = 'rtl';
    ar.lang = 'ar';
    ar.textContent = content.ar;
    box.appendChild(ar);

    if (content.tr) {
      const tr = document.createElement('div');
      tr.className = 'msg-tr';
      tr.textContent = content.tr;
      box.appendChild(tr);
    }
    if (content.en) {
      const en = document.createElement('div');
      en.className = 'msg-en';
      en.textContent = content.en;
      box.appendChild(en);
    }

    const replay = document.createElement('button');
    replay.className = 'msg-replay';
    replay.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4v6h6"/><path d="M23 20v-6h-6"/><path d="M20.5 9a9 9 0 0 0-16.4-1L1 10"/><path d="M3.5 15a9 9 0 0 0 16.4 1L23 14"/></svg> Play';
    replay.addEventListener('click', () => robotSpeak(content.ar));
    box.appendChild(replay);
  } else {
    const txt = document.createElement('div');
    txt.className = 'msg-text';
    txt.textContent = content.text;
    box.appendChild(txt);
  }

  wrap.appendChild(avatar);
  wrap.appendChild(box);
  transcriptEl.appendChild(wrap);
  transcriptEl.scrollTop = transcriptEl.scrollHeight;
}

