function normalizeText(text) {
  return String(text).toLowerCase().trim();
}

function matchBrain(text) {
  const t = normalizeText(text);
  for (const key of Object.keys(BRAIN)) {
    const entry = BRAIN[key];
    if (entry.keys.some(k => t.includes(k.toLowerCase()))) {
      return key;
    }
  }
  return null;
}

function pickRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

function getTeachReply() {
  const unlearned = PHRASES.filter(p => !learned.has(p.id));
  const pool = unlearned.length ? unlearned : PHRASES;
  const phrase = pickRandom(pool);
  state.practice = { phrase, expecting: 'repeat' };

  return [
    { ar:'يلا نتعلم جملة جديدة! قول معايا:', tr:'Yalla netʿallem gomla gedida! ʾUl maʿaya:', en:'Let\'s learn a new phrase! Say with me:' },
    { ar: phrase.ar, tr: phrase.tr, en: phrase.en },
    { ar:'دلوقتي قولها إنت! اضغط المايك وارفع صوتك.', tr:'Dilwaʾti ʾulha enta! Edghat el-mic w erfaʿ sotak.', en:'Now you say it! Tap the mic and speak up.' }
  ];
}

function getFallbackReply() {
  return [
    { ar:'مش فاهم أوي، ممكن تعيد تاني؟', tr:'Mesh fahem awi, momken tʿeid tani?', en:'I don\'t quite understand, can you repeat?' },
    { ar:'جرب تقول: Hello أو Teach me a phrase.', tr:'Garreb tʾul: Hello aw Teach me a phrase.', en:'Try saying: Hello or Teach me a phrase.' }
  ];
}

async function respond(userText) {
  /* Practice mode: user is repeating a phrase */
  if (state.practice && state.practice.expecting === 'repeat') {
    state.practice = null;
    return [
      { ar:'برافو! نطقك كويس جداً.', tr:'Bravo! Notak kewayyes gedan.', en:'Bravo! Your pronunciation is very good.' },
      { ar:'يلا نكمل حاجة تانية.', tr:'Yalla nekmel haga tanya.', en:'Let\'s do another one.' }
    ];
  }

  const key = matchBrain(userText);
  if (!key) return getFallbackReply();
  if (key === 'teach') return getTeachReply();
  return BRAIN[key].replies;
}

